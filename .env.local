# ─── NoWave E-Menu: Local Development ───
# Using SQLite + Prisma locally. Switch to Supabase by replacing DATABASE_URL
# and enabling the Supabase client in src/lib/db.ts.

# DATABASE_URL is set in prisma/.env for Prisma CLI
# At runtime, Prisma Client reads the datasource URL from the schema

# Admin auth secret (change in production!)
AUTH_SECRET="nowave-emenu-secret-key-change-in-production-2024"

# Demo admin credentials (displayed on login screen)
ADMIN_EMAIL="manager@nowave.cafe"
ADMIN_PASSWORD="NoWave2024!"

# ─── Supabase (uncomment when deploying) ───
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
